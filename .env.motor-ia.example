# Variables de entorno para el motor de inferencia M04
# Copiar este archivo a .env.motor-ia.local y completar los valores

# Puerto de escucha del servicio (Alineado a 8100 para entrega E2)
PORT=8100

# Token de autenticación para el endpoint /v1/paquetes (secreto, distinto por ambiente)
IOT_INFERENCIA_M04_TOKEN=

# URL base del backend del mismo ambiente para callbacks o descargas
BACKEND_URL=

# Directorio donde se montará el volumen con catalogo.json y los modelos
MOTOR_IA_DIR_MODELOS=/data/modelos

# Variable para que Swagger arme bien sus enlaces bajo el proxy de Traefik (confirmar nombre exacto en PR #49)
# ROOT_PATH=/model-ia-dev

# Control de hilos para onnxruntime (no exceder el límite de CPU asignado)
OMP_NUM_THREADS=1
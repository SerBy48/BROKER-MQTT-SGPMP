# Envuelve la imagen oficial solo para generar docker/passwd en el arranque
# (ver docker/mosquitto-entrypoint.sh) — necesario porque ese archivo está
# gitignoreado y no existe en un clone nuevo (Dokploy incluido).
FROM eclipse-mosquitto:2@sha256:6f8d8a947c506f8a2290ec65cd4bd2bc7cb4d43fb5f6271f861cb013e2ef9797
COPY docker/mosquitto-entrypoint.sh /mosquitto-entrypoint.sh
RUN chmod +x /mosquitto-entrypoint.sh
ENTRYPOINT ["/mosquitto-entrypoint.sh"]
CMD ["mosquitto", "-c", "/mosquitto/config/mosquitto.conf"]

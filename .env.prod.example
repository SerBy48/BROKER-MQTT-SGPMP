# ==============================================================
# SGPMP - Broker AIoT - Ambiente PROD
# ==============================================================
# ESTO ES SOLO LA PLANTILLA. No contiene ningun valor real y no debe
# contenerlo nunca: es un archivo versionado y publico dentro del repositorio.
#
#   - El archivo `.env.prod` real NUNCA se versiona (`.gitignore` lo excluye).
#   - En PROD los valores NO se cargan desde un archivo: se inyectan como
#     variables de entorno en Dokploy. Este archivo es el catalogo de que
#     variables hay que cargar alli, y quien provee cada valor.
#   - Para validar el compose en local: copiar este archivo como `.env.prod`
#     y completarlo con valores FICTICIOS, nunca con credenciales reales.
#
# Las variables marcadas OBLIGATORIA usan la sintaxis ${VAR:?...} en
# docker-compose.prod.yml: si faltan, `docker compose config` falla con un
# mensaje explicito en vez de levantar un contenedor mal configurado. Una
# variable presente pero VACIA cuenta como faltante, que es el comportamiento
# deseado.
#
# A diferencia de DEV y TEST, docker-compose.prod.yml NO usa `env_file`: cada
# variable esta enumerada explicitamente en el servicio que la consume. Por
# eso este archivo es el contrato de configuracion que se le entrega a
# Despliegue, no un archivo que el contenedor vaya a leer.
#
# NO existe `DATABASE_URL` en esta plantilla, a diferencia de `.env.example`
# (DEV). Es deliberado: el compose de PROD la arma a partir de DB_IOT_USER,
# DB_IOT_PASSWORD, DB_HOST y DB_NAME, para que cada pieza se valide por
# separado y la contrasena no viaje como parte de una URL en el panel de
# Dokploy. No agregarla por analogia con el otro ambiente.
#
# NO existe `GATEWAY_API_TOKEN`. Ver la nota de autenticacion mas abajo.
# ==============================================================


# ==============================================================
# PostgreSQL — base compartida con sgpmp-backend
# ==============================================================
# Este stack NO levanta base de datos propia: se conecta a la misma PostgreSQL
# que usa sgpmp-backend, sobre los esquemas modulo3 y modulo9. Las cuatro
# variables de este bloque son OBLIGATORIAS y las provee el DBA.
#
# DB_HOST — OBLIGATORIA.
# Debe coincidir EXACTAMENTE con el `container_name` del servicio de base de
# datos del stack del backend, que alli se define como `${POSTGRES_DB}-db`. Se
# alcanza por la red compartida `sgpmp-network` usando el puerto INTERNO 5432,
# que el compose de PROD del broker ya fija; por eso aqui va solo el hostname,
# SIN puerto.
# NUNCA copiar el patron `host:puerto-publicado` de un stack a otro: ese es
# exactamente el error que produjo el incidente del 7 de septiembre, en el que
# el gateway devolvia 500 en DEV con
# `socket.gaierror: Temporary failure in name resolution` porque su
# DATABASE_URL apuntaba a un hostname de otra red.
DB_HOST=

# DB_NAME — OBLIGATORIA.
# Nombre de la base del backend. Es el mismo valor que POSTGRES_DB en el
# `.env.prod` del backend, y el que forma el hostname de DB_HOST.
DB_NAME=

# DB_IOT_USER y DB_IOT_PASSWORD — OBLIGATORIAS.
# Credencial propia del gateway, distinta de la del backend. El rol es
# `member_iot`, restringido a los esquemas modulo3 y modulo9: el gateway no
# necesita ni debe tener acceso al resto de la base.
# PENDIENTE: ese rol no existe todavia en ningun ambiente construido desde
# cero; el baseline no crea roles de aplicacion ni otorga GRANTs. Su creacion
# y sus permisos corresponden al DBA, antes del primer despliegue de PROD.
DB_IOT_USER=
DB_IOT_PASSWORD=


# ==============================================================
# Esquemas de la base existente
# ==============================================================
# Opcionales, con default en el compose. Fijos por diseno: el broker no corre
# migraciones ni crea esquemas, solo escribe sobre los que ya existen.
DB_SCHEMA_INGEST=modulo3
DB_SCHEMA_REGISTRY=modulo9


# ==============================================================
# Credencial del GATEWAY contra Mosquitto
# ==============================================================
# OBLIGATORIAS. Las provee AIoT.
# Es la credencial con la que el proceso del gateway se conecta al broker. El
# mismo par se inyecta en los dos servicios del compose: en `mosquitto`, para
# que el entrypoint lo cree como admin de dynamic-security (y rote su clave en
# cada arranque), y en `gateway`, para que la use al conectarse. Si las dos puntas no coinciden, el
# gateway se queda en el bucle de reconexion sin ingestar nada, mientras
# /v1/healthz sigue respondiendo 200.
# Distintas de las de DEV y TEST. No reutilizar entre ambientes.
MQTT_USERNAME=
MQTT_PASSWORD=


# ==============================================================
# Credencial COMPARTIDA legacy de los dispositivos (TC-M09-250/251)
# ==============================================================
# OPCIONALES. Lo esperado en PROD es dejarlas VACIAS.
#
# Desde SEG-BROKER-03 cada Gateway Edge tiene su propia credencial MQTT
# (usuario = su serial), con ACL de minimo privilegio sobre sus topics y los
# de los dispositivos que atiende. Se genera desde la plataforma
# (POST /v1/devices/{serial}/credential) y la guarda dynamic-security, no un
# archivo de contrasenas.
#
# La credencial compartida solo existe para no cortar a los Edge que todavia
# no migraron: mientras este definida, el gateway la mantiene en
# dynamic-security con la ACL de siempre (cualquier serial). PROD arranca con
# credenciales por Edge, asi que no hace falta. Si alguna vez se define y
# luego se borra, el gateway elimina ese usuario al reconectar.
MQTT_DEVICE_USERNAME=
MQTT_DEVICE_PASSWORD=


# ==============================================================
# Puertos MQTT publicados al host
# ==============================================================
# OBLIGATORIAS, y PENDIENTES DE CONFIRMAR por Despliegue y AIoT.
#
# MQTT no es HTTP: Traefik no lo enruta por dominio, asi que el broker es el
# unico servicio del stack que publica puertos de host. Hay que pedir a
# Despliegue que los habilite en el firewall del servidor.
#
# A proposito NO tienen valor por defecto en docker-compose.prod.yml, a
# diferencia de DEV (1884/9001) y TEST (1885/9002): un default silencioso
# llevaria a desplegar con un puerto que nadie acordo. `docker compose config`
# falla si faltan. El 1883 estandar NO esta disponible: en el servidor Dokploy
# compartido lo ocupa el contenedor EMQX de otro proyecto.
#
# CUIDADO CON EL NOMBRE: es MQTT_HOST_PORT, no MQTT_PORT. El gateway lee una
# env var MQTT_PORT, pero para el puerto INTERNO de conexion a mosquitto
# (1883, fijado en el compose, no cambia nunca). Ya paso una vez.
MQTT_HOST_PORT=
MQTT_WS_HOST_PORT=


# ==============================================================
# TLS hacia afuera (SEG-BROKER-02, TC-M09-253)
# ==============================================================
# MQTT_PUERTO_PUBLICO / MQTT_WS_PUERTO_PUBLICO — opcionales, default 8883 y
# 9002 en PROD: el host publica SOLO los listeners TLS (mqtts / wss) y el
# texto plano (1883/9001) queda dentro de la red interna, donde lo usa el
# gateway.
#
# Prerrequisito de despliegue: certificados en ./docker/certs
# (fullchain.pem + privkey.pem, convencion Let's Encrypt/certbot; ver
# docker/certs/README.md). Los provee Ops y NUNCA se versionan. Si faltan, el
# entrypoint de mosquitto aborta el arranque a proposito: es preferible un
# broker caido y visible a uno que expone credenciales en texto plano.
#
# Volver a 1883/9001 solo para un diagnostico puntual, nunca como estado de
# PROD.
MQTT_PUERTO_PUBLICO=8883
MQTT_WS_PUERTO_PUBLICO=9002

# MQTT_TLS — opcional, default `false`, y DEBE quedar en false.
# NO es el interruptor de TLS del broker: controla si el GATEWAY usa TLS al
# conectarse a mosquitto por la red interna, que es un listener en claro.
# Ponerla en `true` hace que el handshake falle y que el contenedor quede
# `healthy` sin ingestar nada (/v1/healthz no comprueba MQTT). El TLS de los
# dispositivos lo dan los listeners de arriba, no esta variable.
MQTT_TLS=false


# ==============================================================
# Topics y comportamiento del cliente MQTT
# ==============================================================
# Todas opcionales, con default en el compose. Las define AIoT.
# La convencion de topics es <prefijo>/<serial>/<telemetry|heartbeat|status|
# command|resultado>, con el serial tomado de modulo9.dispositivos_iot.
# Cambiarlas rompe el contrato con el firmware ya desplegado.
MQTT_CLIENT_ID=sgpmp
MQTT_RECONNECT_DELAY=5
MQTT_TOPIC_PREFIX=sgpmp
MQTT_TOPIC_TELEMETRY=telemetry
MQTT_TOPIC_HEARTBEAT=heartbeat
MQTT_TOPIC_COMMAND=command
MQTT_TOPIC_STATUS=status
# BRK-01: resultado de cada ingesta hacia el nodo (libera o retiene su buffer).
MQTT_TOPIC_RESULTADO=resultado

# MQTT_ACK_TIMEOUT_SECONDS — opcional, default 30.
# Segundos que /v1/commands espera el ACK del dispositivo antes de responder
# NO_CONF. Es contrato RF-23 con el backend: cambiarlo aqui sin coordinarlo
# alli desalinea los dos timeouts.
MQTT_ACK_TIMEOUT_SECONDS=30

# MQTT_ACK_REQUIERE_ID_COMANDO — opcional, default false (TC-M09-252).
# true = un ACK que no devuelve el id_comando no confirma ningun comando
# (anti-replay completo). Pasar a true cuando AIoT confirme que todo el
# firmware de PROD ya lo devuelve.
MQTT_ACK_REQUIERE_ID_COMANDO=false


# ==============================================================
# sgpmp-backend (BRK-02, P3 de AIOT-DEV-03)
# ==============================================================
# BACKEND_URL — OBLIGATORIA. URL INTERNA del backend en `sgpmp-network`
# (nombre del servicio del stack del backend + su puerto interno), igual que
# DB_HOST. Nunca el dominio publico: el trafico broker -> backend no sale del
# servidor. El broker reenvia ahi los eventos de control de bajo volumen
# (buffer, vision, eventos Edge, reportes OTA).
BACKEND_URL=

# BROKER_SERVICE_TOKEN — OBLIGATORIA. Token de servicio con el que el broker se
# autentica ante el backend (Authorization: Bearer). Es el MISMO valor que
# BROKER_SERVICE_TOKEN en el backend; se genera una vez (p. ej.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`), se entrega
# por canal seguro a quien carga las dos variables en Dokploy y nunca se
# escribe en un archivo versionado. Es distinto del token del sentido
# contrario (backend -> broker, ver la nota de autenticacion de abajo).
BROKER_SERVICE_TOKEN=

# BACKEND_TIMEOUT_SECONDS — opcional, default 10.
BACKEND_TIMEOUT_SECONDS=10


# ==============================================================
# API HTTP
# ==============================================================
# Opcionales, con default en el compose.
# El servicio no publica puertos de host: Traefik lo enruta por dominio,
# apuntando al puerto interno 8000.
#
# Nota: el CMD del Dockerfile arranca uvicorn con `--host 0.0.0.0 --port 8000`
# literal. Estas dos variables se leen en app/config.py pero no cambian donde
# escucha el proceso; cambiarlas no mueve el puerto. Se documentan para que
# nadie intente reconfigurar el puerto por aqui.
API_HOST=0.0.0.0
API_PORT=8000


# ==============================================================
# Autenticacion del backend contra el gateway — NO es variable de este repo
# ==============================================================
# El gateway valida el encabezado `Authorization: Bearer` calculando su
# SHA-256 y comparandolo contra la tabla modulo1.credenciales_servicio, con
# nombre_servicio='broker_mqtt' y es_activo=true. Si esa fila no existe, el
# gateway rechaza TODAS las llamadas autenticadas con 401.
#
# La siembra de esa fila corresponde al DBA y es un prerrequisito de
# despliegue, no una variable de entorno.
#
# Documentacion previa del proyecto menciona un `GATEWAY_API_TOKEN` estatico:
# ESE DISENO QUEDO SUPERADO y no debe aparecer en esta plantilla ni cargarse
# en Dokploy.

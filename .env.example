# =============================================================================
# SGPMP — variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# =============================================================================

# --- PostgreSQL existente (no se corren migraciones sobre esta base) ---------
# Este broker NO levanta su propia base de datos: se conecta a la misma
# Postgres que ya usa sgpmp-backend (schemas modulo3/modulo9). En Dokploy,
# usa el host/puerto donde esa base es alcanzable para ese ambiente (mismo
# criterio que DATABASE_URL en el backend: mismas credenciales POSTGRES_*
# y mismo DB_PORT publicado allá).
DATABASE_URL=postgresql+asyncpg://usuario:cambiar_esta_clave@host:5447/sgpmp

# Schemas de la base existente
DB_SCHEMA_INGEST=modulo3
DB_SCHEMA_REGISTRY=modulo9

# --- Broker MQTT (Mosquitto) -------------------------------------------------
# MQTT_HOST y MQTT_PORT se sobreescriben en docker-compose.yml (mosquitto /
# 1883, puerto INTERNO fijo) — no hace falta definirlos acá para Docker,
# quedan como valor de referencia para correr sin Docker.
#
# Para el puerto publicado hacia afuera (host/firewall) NO se usa esta
# misma variable: es MQTT_HOST_PORT / MQTT_WS_HOST_PORT, definida como env
# var en Dokploy (no acá). Usar MQTT_PORT para eso rompe la conexión
# interna del gateway — ver nota en docker-compose.yml.
#
# SEG-BROKER-02 (TLS): ver MQTT_PUERTO_PUBLICO más abajo.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Usuario del gateway. También es el admin de dynamic-security (SEG-BROKER-03):
# el entrypoint de mosquitto lo crea en el primer arranque y rota su clave en
# cada arranque. No cambiar el usuario en un ambiente ya desplegado (ver
# docker/mosquitto-entrypoint.sh).
MQTT_USERNAME=sgpmp_gateway
MQTT_PASSWORD=changeme

# Credencial COMPARTIDA legacy de los dispositivos IoT (TC-M09-250/251). Cada
# Raspberry ahora tiene su propia credencial, generada desde la plataforma
# (POST /v1/devices/{serial}/credential). Esta solo existe para no cortar a las
# Raspberry que todavía no migraron: el gateway la mantiene en dynamic-security
# con los permisos de siempre. Cuando todas migraron, BORRAR estas dos variables
# en Dokploy: el gateway elimina ese usuario al reconectar y recién ahí quedan
# cerrados TC-M09-250/251.
MQTT_DEVICE_USERNAME=sgpmp_devices
MQTT_DEVICE_PASSWORD=changeme

MQTT_TLS=false
MQTT_CLIENT_ID=sgpmp

# TC-M09-253 (TLS obligatorio hacia afuera). Puerto del CONTENEDOR que se publica
# en MQTT_HOST_PORT / MQTT_WS_HOST_PORT. Definir en Dokploy, no acá. Default:
# texto plano (dev). En test/prod: MQTT_PUERTO_PUBLICO=8883 y
# MQTT_WS_PUERTO_PUBLICO=9002, con certificados en docker/certs/ — si faltan, el
# broker no arranca (ver docker/certs/README.md).
MQTT_PUERTO_PUBLICO=1883
MQTT_WS_PUERTO_PUBLICO=9001
MQTT_RECONNECT_DELAY=5

# Convención de topics (configurable)
MQTT_TOPIC_PREFIX=sgpmp
MQTT_TOPIC_TELEMETRY=telemetry
MQTT_TOPIC_HEARTBEAT=heartbeat
MQTT_TOPIC_COMMAND=command
MQTT_TOPIC_STATUS=status
MQTT_ACK_TIMEOUT_SECONDS=30
# TC-M09-252 (anti-replay): el ACK debe devolver el id_comando del comando. false =
# un ACK sin id todavía se acepta (firmware que aún no lo devuelve); un ACK con un
# id distinto se ignora siempre. Pasar a true cuando IoT confirme que ya lo devuelve.
MQTT_ACK_REQUIERE_ID_COMANDO=false

# --- API HTTPS -----------------------------------------------------------
# Sin token estático: /v1/commands valida el Bearer contra
# modulo1.credenciales_servicio (nombre_servicio='broker_mqtt', hash sha256).
API_HOST=0.0.0.0
API_PORT=8000
